# N1/N2 实验路由器镜像（netcheck-n1-lab）
#
# 说明：本镜像仅用于本地可复现实验（Docker bridge 网络内验证 SNMPv3 authPriv +
# SSH 只读 + 配置备份）。所有凭据均为【文档测试值】（见 Obsidian 16 N2.1 归档），
# 仅供实验、无生产价值；可通过 --build-arg 覆盖，避免在镜像中固化自定义口令。
#
# 试用例：netcheckauth / netcheckpriv / netcheck123 / public
# 生产/真实设备禁止直接使用本镜像或这些凭据。
ARG ALPINE_TAG=3.22
FROM alpine:${ALPINE_TAG}

# 凭据可覆盖（默认 = 文档测试值）
ARG SNMP_USER=monitor
ARG SNMP_AUTH_KEY=netcheckauth
ARG SNMP_PRIV_KEY=netcheckpriv
ARG ROOT_PASSWORD=netcheck123
# SNMPv3 认证算法：必须与采集端一致（collector 默认 SHA-256 / AES-128）。
# net-snmp 5.9.x createUser 支持 SHA-256（RFC 7860 HMAC-SHA-2-256）；AES = AES-128(CFB128)。
ARG SNMP_AUTH_ALGO=SHA-256
ARG SNMP_PRIV_ALGO=AES

RUN apk add --no-cache net-snmp openssh-server openssh-client net-snmp-tools \
    && ssh-keygen -A \
    && sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && echo "Port 2222" >> /etc/ssh/sshd_config \
    && echo "root:${ROOT_PASSWORD}" | chpasswd \
    && mkdir -p /run/openrc && touch /run/openrc/softlevel

# SNMPv3 authPriv 用户（认证算法与采集端一致，见上方注释）
RUN cat > /etc/snmp/snmpd.conf <<SNMP
rocommunity public default
createUser ${SNMP_USER} ${SNMP_AUTH_ALGO} ${SNMP_AUTH_KEY} ${SNMP_PRIV_ALGO} ${SNMP_PRIV_KEY}
rouser ${SNMP_USER} priv
sysLocation lab
sysContact test
SNMP

ENTRYPOINT ["sh", "-c", "snmpd -f -u root -LS0-6d & /usr/sbin/sshd -D"]