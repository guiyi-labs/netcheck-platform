# ============================================================
# netcheck-platform 环境变量示例
# 复制为项目根目录 .env 后按需修改；后端也能读取同名系统环境变量。
# 所有变量前缀为 NETCHECK_，对应 backend/app/core/config.py 中的 Settings 字段。
# ============================================================

# ---- 服务与数据 ----
NETCHECK_SERVICE_NAME=netcheck-backend
NETCHECK_VERSION=0.2.0
# SQLite（默认）
NETCHECK_DATABASE_URL=sqlite:///./data/netcheck.db
# MySQL 示例（pymysql 已包含在 requirements.txt）：
# NETCHECK_DATABASE_URL=mysql+pymysql://netcheck:netcheck@127.0.0.1:3306/netcheck?charset=utf8mb4
NETCHECK_REPORTS_DIR=./data/reports
NETCHECK_BACKUP_DIR=./data/backups
NETCHECK_LOG_LEVEL=INFO

# ---- 检测参数 ----
NETCHECK_PING_TIMEOUT=3.0
NETCHECK_TCP_TIMEOUT=3.0
NETCHECK_HTTP_TIMEOUT=5.0
NETCHECK_SLOW_RESPONSE_THRESHOLD=2000.0
NETCHECK_CHECK_CONCURRENCY=8
NETCHECK_TLS_EXPIRY_WARNING_DAYS=30

# ---- 登录安全 ----
NETCHECK_TOKEN_TTL_HOURS=24
NETCHECK_LOGIN_MAX_ATTEMPTS=5
NETCHECK_LOGIN_LOCK_MINUTES=15
NETCHECK_PASSWORD_MIN_LENGTH=8

# ---- 告警通知（可选，B 阶段实现）----
NETCHECK_NOTIFICATION_ENABLED=false
NETCHECK_NOTIFICATION_MIN_LEVEL=warning
NETCHECK_SMTP_HOST=
NETCHECK_SMTP_PORT=465
NETCHECK_SMTP_USER=
NETCHECK_SMTP_PASSWORD=
NETCHECK_SMTP_FROM=
NETCHECK_SMTP_TO=
NETCHECK_SMTP_USE_SSL=true
NETCHECK_WEBHOOK_URL=
NETCHECK_WEBHOOK_HEADERS=

# ---- AI 诊断增强（可选，D 阶段实现）----
NETCHECK_AI_DIAGNOSIS_ENABLED=false
NETCHECK_AI_BASE_URL=
NETCHECK_AI_API_KEY=
NETCHECK_AI_MODEL=
NETCHECK_AI_TIMEOUT=30.0